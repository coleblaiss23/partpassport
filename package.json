{
  "name": "part-passport",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "org:create": "tsx --env-file=.env scripts/create-org.ts",
    "flags:import": "tsx --env-file=.env scripts/importSafetyFlags.ts",

# Database (Postgres). Use the pooled connection string in production.
DATABASE_URL=

# Secrets: generate each with `openssl rand -hex 32`
ADMIN_TOKEN=
SESSION_SECRET=

# Certificate analysis
# - Leave ANTHROPIC_API_KEY set for real 8130-3 / Form 1 PDF extraction (recommended for scanned forms).
# - AI_MODE=local: PDF text layer → known sample map → Tesseract OCR (no cloud). AI_MODE=mock is treated as local.
ANTHROPIC_API_KEY=
AI_MODE=local
ANTHROPIC_MODEL=
AI_DAILY_CAP=500

# Site
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Billing (Stripe)
# Checkout needs STRIPE_SECRET_KEY + STRIPE_PRICE_PRO (Stripe Price id for MRO Professional).
# Optional Payment Link used by some marketing CTAs.
# In development, missing Stripe config falls back to a local billing mock (BILLING_DEV_MOCK=0 to disable).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
BILLING_DEV_MOCK=1

# Lead alerts (Slack or Discord incoming webhook)
LEAD_WEBHOOK_URL=

# Shared rate limiting (Upstash Redis REST). Falls back to per-instance memory when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Testing only
PILOT_CHECK_LIMIT=
PILOT_REG_LIMIT=
DISABLE_RATE_LIMIT=
# Database (Postgres). Use the pooled connection string in production.
DATABASE_URL=

# Secrets: generate each with `openssl rand -hex 32`
ADMIN_TOKEN=
SESSION_SECRET=

# Certificate analysis. Leave AI_MODE unset in production; AI_MODE=mock returns canned results for demos and tests.
ANTHROPIC_API_KEY=
AI_MODE=
AI_DAILY_CAP=500

# Site
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Billing (Stripe)
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Lead alerts (Slack or Discord incoming webhook)
LEAD_WEBHOOK_URL=

# Shared rate limiting (Upstash Redis REST). Falls back to per-instance memory when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Testing only
PILOT_CHECK_LIMIT=
PILOT_REG_LIMIT=
DISABLE_RATE_LIMIT=

# Database (Postgres). Use the pooled connection string in production.
DATABASE_URL=

# Secrets: generate each with `openssl rand -hex 32`
ADMIN_TOKEN=
SESSION_SECRET=
# Optional dedicated key for encrypted auditor share links (falls back to SESSION_SECRET)
AUDIT_SHARE_SECRET=

# Super-admin / owner dashboard at /admin
# - Sign in with ADMIN_TOKEN (sets HTTP-only pp_admin session, 8h).
# - API routes also accept header: x-admin-token: <ADMIN_TOKEN>
# - Requires ADMIN_TOKEN (16+) and SESSION_SECRET (32+).

# Certificate analysis
# - Production: set ANTHROPIC_API_KEY and leave AI_MODE unset. AI_MODE=local or mock forces
#   Tesseract OCR even when a key is present.
# - Development with no key already uses local OCR (PDF text → known sample map → Tesseract).
# - AI_MODE=off disables analysis. AI_MODE=mock is treated as local.
# - ANTHROPIC_MODEL defaults to claude-sonnet-5-5 when unset.
ANTHROPIC_API_KEY=
AI_MODE=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_CAP=500

# Site
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Billing (Stripe)
# Checkout needs STRIPE_SECRET_KEY + at least one price id (STARTER / PROFESSIONAL / ENTERPRISE).
# STRIPE_PRICE_PRO is accepted as a legacy alias for PROFESSIONAL.
# Optional Payment Link used by some marketing CTAs.
# In development, missing Stripe config falls back to a local billing mock (BILLING_DEV_MOCK=0 to disable).
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=
BILLING_DEV_MOCK=1

# Lead alerts (Slack or Discord incoming webhook)
LEAD_WEBHOOK_URL=

# Shared rate limiting (Upstash Redis REST). Falls back to per-instance memory when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Testing only
STARTER_CHECK_LIMIT=
STARTER_REG_LIMIT=
PILOT_CHECK_LIMIT=
PILOT_REG_LIMIT=
DISABLE_RATE_LIMIT=
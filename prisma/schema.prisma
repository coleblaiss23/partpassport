generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgVerification {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum Plan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum ComplianceStatus {
  OPEN
  COMPLIED
  NOT_APPLICABLE
  OVERDUE
}

enum LimitBasis {
  CALENDAR
  HOURS
  CYCLES
}

enum DocumentKind {
  LOGBOOK
  INVOICE
  CERTIFICATE
  OTHER
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  FAILED
}

enum WorkOrderStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum InvoicePaymentStatus {
  PENDING
  PAID
  CHECK_RECEIVED
  VOID
}

enum PaymentMethodHint {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  CHECK
  MANUAL
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  clerkOrgId           String?               @unique
  faaCertNumber        String? // self-reported until verified
  easaApprovalNumber   String?
  verification         OrgVerification       @default(UNVERIFIED)
  verifiedAt           DateTime?
  publicKey            String
  encPrivateKey        String? // AES-GCM envelope. Null for bring-your-own-key orgs
  keyVersion           Int                   @default(1)
  active               Boolean               @default(true)
  plan                 Plan                  @default(STARTER)
  stripeCustomerId     String?               @unique
  stripeSubId          String?               @unique
  subStatus            String?
  currentPeriodEnd     DateTime?
  trialEndsAt          DateTime?
  /// Null = use plan default (STARTER=5, PROFESSIONAL/ENTERPRISE unlimited)
  maxAircraft          Int?
  /// Optional org-level feature overrides (JSON)
  features             String?
  createdAt            DateTime              @default(now())
  apiKeys              ApiKey[]
  parts                Part[]                @relation("CurrentCustodian")
  events               PartEvent[]
  checks               CertificateCheck[]
  auditLogs            AuditLog[]
  approvedVendors      ApprovedVendor[]
  complianceItems      ComplianceItem[]
  auditShares          AuditShare[]
  aircraft             Aircraft[]
  shops                Shop[]
  workOrders           WorkOrder[]
  invoices             Invoice[]
  documentUploads      DocumentUpload[]
  webhookEndpoints     WebhookEndpoint[]
  mechanicCertificates MechanicCertificate[]
  lifeLimitedComponents LifeLimitedComponent[]
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  prefix         String // first characters, safe to display
  hash           String       @unique // SHA-256 of the full key
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  action         String
  meta           String? // JSON
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model StripeEvent {
  id         String   @id // Stripe event id, used to ignore duplicate webhooks
  type       String
  receivedAt DateTime @default(now())
}

model Part {
  id                   String         @id @default(cuid())
  partNumber           String
  serialNumber         String
  description          String?
  scrapped             Boolean        @default(false)
  isLifeLimited        Boolean        @default(false)
  totalTimeHours       Float?
  totalCycles          Int?
  lifeLimitHours       Float?
  lifeLimitCycles      Int?
  custodyStatus        String         @default("QUARANTINE") // QUARANTINE | SERVICEABLE | UNSERVICEABLE
  birthCertificateHash String? // digital birth certificate / manufacture release hash
  currentOrgId         String?
  currentOrg           Organization?  @relation("CurrentCustodian", fields: [currentOrgId], references: [id])
  events               PartEvent[]
  createdAt            DateTime       @default(now())

  @@unique([partNumber, serialNumber])
  @@index([currentOrgId])
  @@index([currentOrgId, custodyStatus])
  @@index([currentOrgId, isLifeLimited])
}

model PartEvent {
  id              String       @id @default(cuid())
  partId          String
  part            Part         @relation(fields: [partId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  seq             Int
  actorUserId     String? // the signed-in person who performed the action
  eventType       String // CREATED | INSPECTED | REPAIRED | OVERHAULED | INSTALLED | REMOVED | SCRAPPED | SOLD | TRANSFERRED
  timestamp       DateTime
  prevEventHash   String?
  eventHash       String
  signature       String // Base64 Ed25519
  data            String // exact JSON text that was hashed (never re-serialized)
  certificateHash String? // SHA-256 of attached PDF
  createdAt       DateTime     @default(now())

  @@unique([partId, seq])
  @@index([partId, timestamp])
  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, createdAt])
}

model CertificateCheck {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fileName       String
  actorUserId    String?
  sha256         String
  extracted      String // JSON
  redFlags       String // JSON array
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model SafetyFlag {
  id               String             @id @default(cuid())
  partNumber       String
  partNumberNorm   String
  source           String // "AD" or "SDR"
  referenceId      String
  description      String
  serialRangeStart String?
  serialRangeEnd   String?
  issuedDate       DateTime
  url              String?
  createdAt        DateTime           @default(now())
  aircraftStatuses  AircraftADStatus[]

  @@unique([source, referenceId, partNumberNorm])
  @@index([partNumberNorm])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  role      String?
  volume    String? // certificates per month, self-reported
  message   String?
  source    String? // e.g. "starter", "professional", "enterprise"
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model RepairStation {
  id             String   @id @default(cuid())
  certNumber     String   @unique // e.g. "RS1R..."
  name           String
  location       String?
  status         String   @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  airworthiness  Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model ApprovedVendor {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierName      String
  certificateNumber String
  expiresAt         DateTime?
  ratings           String? // e.g. "Limited Airframe, Instruments" or CSV ratings list
  isActive          Boolean      @default(true)
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, supplierName, certificateNumber])
  @@index([organizationId, isActive])
  @@index([organizationId, supplierName])
  @@index([organizationId, expiresAt])
  @@map("approved_vendors")
}

/// Shop tool calibrations, vendor cert expirations, inspection authorizations.
model ComplianceItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       String // TOOL_CALIBRATION | VENDOR_CERT | INSPECTION_AUTH
  name           String
  reference      String?
  expiresAt      DateTime
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, expiresAt])
  @@index([organizationId, category])
}

/// Temporary encrypted share links for external FAA auditors / airline customers.
model AuditShare {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tokenHash      String       @unique
  label          String?
  /// CERT_CHECK | PART_PASSPORT
  packageType    String
  resourceId     String
  /// AES-GCM ciphertext of the package payload (base64)
  encPayload     String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  lastAccessedAt DateTime?

  @@index([organizationId, createdAt])
  @@index([expiresAt])
}

/// Admin-managed training videos for MRO receiving / quality staff.
model TutorialVideo {
  id          String   @id @default(cuid())
  title       String
  description String?
  /// YouTube/Vimeo watch or embed URL, or direct MP4
  embedUrl    String
  /// AVL | INTAKE | AUDIT_SHARE | GENERAL
  category    String   @default("GENERAL")
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  duration    String? // e.g. "4:20"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([category])
}

/// Multi-location shop (Enterprise).
model Shop {
  id                     String       @id @default(cuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                   String
  location               String?
  faaRepairStationNumber String?
  active                 Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  workOrders             WorkOrder[]
  invoices               Invoice[]

  @@index([organizationId, active])
}

/// Cached FAA / ADS-B style N-number registry metadata for fleet enrichment.
model AircraftRegistry {
  id           String   @id @default(cuid())
  /// Normalized N-number (e.g. N4867W)
  tailNumber   String   @unique
  make         String
  model        String
  year         Int?
  serialNumber String?
  engineModel  String?
  series       String?
  /// FAA | ADSB | MANUAL | IMPORT
  source       String   @default("MANUAL")
  rawPayload   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([make, model])
}

/// Fleet aircraft / tail number hub.
model Aircraft {
  id                    String                  @id @default(cuid())
  organizationId        String
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tailNumber            String
  make                  String
  model                 String
  year                  Int?
  series                String?
  serialNumber          String?
  engineModel           String?
  airframeHours         Float?
  hobbsHours            Float?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  adStatuses             AircraftADStatus[]
  lifeLimitedComponents LifeLimitedComponent[]
  documentUploads       DocumentUpload[]
  workOrders            WorkOrder[]
  invoices              Invoice[]

  @@unique([organizationId, tailNumber])
  @@index([organizationId])
  @@index([tailNumber])
}

/// Per-tail AD / safety-flag compliance tracking.
model AircraftADStatus {
  id                String           @id @default(cuid())
  aircraftId        String
  aircraft          Aircraft         @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  safetyFlagId      String
  safetyFlag        SafetyFlag       @relation(fields: [safetyFlagId], references: [id], onDelete: Cascade)
  status            ComplianceStatus @default(OPEN)
  compliedAt        DateTime?
  dueAt             DateTime?
  notes             String?
  signedOffByUserId String?
  signedOffByName   String?
  signedOffAt       DateTime?
  certificateRef    String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([aircraftId, safetyFlagId])
  @@index([aircraftId, status])
  @@index([safetyFlagId])
}

/// Airframe-installed life-limited / calendar items (BRS, hoses, magnetos, overhauls).
model LifeLimitedComponent {
  id             String       @id @default(cuid())
  aircraftId     String
  aircraft       Aircraft     @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// BRS | HOSE | MAGNETO | OVERHAUL | OTHER
  category       String       @default("OTHER")
  limitBasis     LimitBasis
  installedAt    DateTime?
  dueAt          DateTime?
  intervalDays   Int?
  intervalHours  Float?
  intervalCycles Int?
  currentHours   Float?
  currentCycles  Int?
  lastCompliedAt DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([aircraftId])
  @@index([organizationId, dueAt])
  @@index([organizationId, category])
}

/// Scanned logbook / invoice / certificate uploads for OCR extraction.
model DocumentUpload {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aircraftId       String?
  aircraft         Aircraft?      @relation(fields: [aircraftId], references: [id], onDelete: SetNull)
  workOrderId      String?
  workOrder        WorkOrder?     @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  kind             DocumentKind   @default(OTHER)
  status           DocumentStatus @default(UPLOADED)
  fileName         String
  mimeType         String
  byteSize         Int
  storageKey       String
  sha256           String?
  extracted        String? // JSON
  errorMessage     String?
  uploadedByUserId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([organizationId, createdAt])
  @@index([aircraftId])
  @@index([workOrderId])
  @@index([status])
}

model WorkOrder {
  id                     String           @id @default(cuid())
  organizationId         String
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopId                 String?
  shop                   Shop?            @relation(fields: [shopId], references: [id], onDelete: SetNull)
  aircraftId             String?
  aircraft               Aircraft?        @relation(fields: [aircraftId], references: [id], onDelete: SetNull)
  number                 String
  status                 WorkOrderStatus  @default(DRAFT)
  title                  String
  description            String?
  openedAt               DateTime         @default(now())
  closedAt               DateTime?
  assignedMechanicUserId String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  invoices               Invoice[]
  documentUploads        DocumentUpload[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([aircraftId])
  @@index([shopId])
}

model Invoice {
  id                      String                @id @default(cuid())
  organizationId          String
  organization            Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shopId                  String?
  shop                    Shop?                 @relation(fields: [shopId], references: [id], onDelete: SetNull)
  aircraftId              String?
  aircraft                Aircraft?             @relation(fields: [aircraftId], references: [id], onDelete: SetNull)
  workOrderId             String?
  workOrder               WorkOrder?            @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  number                  String
  amountCents             Int
  currency                String                @default("usd")
  paymentStatus           InvoicePaymentStatus  @default(PENDING)
  stripePaymentIntentId   String?               @unique
  stripeCheckoutSessionId String?               @unique
  paymentMethodHint       PaymentMethodHint?
  paidAt                  DateTime?
  checkReceivedAt         DateTime?
  customerEmail           String?
  lineItems               String? // JSON
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, paymentStatus])
  @@index([aircraftId])
  @@index([workOrderId])
  @@index([shopId])
}

model MechanicCertificate {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clerkUserId       String
  displayName       String
  /// A&P | IA | etc.
  certificateType   String
  certificateNumber String
  expiresAt         DateTime?
  ratings           String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([organizationId, certificateNumber])
  @@index([organizationId, clerkUserId])
  @@index([organizationId, expiresAt])
}

model WebhookEndpoint {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url             String
  secretHash      String
  /// CSV or JSON list of event names
  events          String
  active          Boolean      @default(true)
  lastDeliveredAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, active])
}

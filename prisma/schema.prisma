generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  publicKey   String // Ed25519 PEM. Private key is never stored.
  apiKeyHash  String             @unique // SHA-256 of the org API key
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  parts       Part[]             @relation("CurrentCustodian")
  events      PartEvent[]
  checks      CertificateCheck[]
}

model Part {
  id           String        @id @default(cuid())
  partNumber   String
  serialNumber String
  description  String?
  scrapped     Boolean       @default(false)
  currentOrgId String?
  currentOrg   Organization? @relation("CurrentCustodian", fields: [currentOrgId], references: [id])
  events       PartEvent[]
  createdAt    DateTime      @default(now())

  @@unique([partNumber, serialNumber])
}

model PartEvent {
  id              String       @id @default(cuid())
  partId          String
  part            Part         @relation(fields: [partId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  seq             Int
  eventType       String // CREATED | INSPECTED | REPAIRED | OVERHAULED | INSTALLED | REMOVED | SCRAPPED | SOLD | TRANSFERRED
  timestamp       DateTime
  prevEventHash   String?
  eventHash       String
  signature       String // Base64 Ed25519
  data            String // exact JSON text that was hashed (never re-serialized)
  certificateHash String? // SHA-256 of attached PDF
  createdAt       DateTime     @default(now())

  @@unique([partId, seq])
  @@index([partId, timestamp])
}

model CertificateCheck {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fileName       String
  sha256         String
  extracted      String // JSON
  redFlags       String // JSON array
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

model SafetyFlag {
  id               String   @id @default(cuid())
  partNumber       String
  partNumberNorm   String
  source           String // "AD" or "SDR"
  referenceId      String
  description      String
  serialRangeStart String?
  serialRangeEnd   String?
  issuedDate       DateTime
  url              String?
  createdAt        DateTime @default(now())

  @@unique([source, referenceId, partNumberNorm])
  @@index([partNumberNorm])
}

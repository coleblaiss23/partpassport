generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgVerification {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum Plan {
  PILOT
  PRO
  ENTERPRISE
}

model Organization {
  id                 String             @id @default(cuid())
  name               String
  clerkOrgId         String?            @unique
  faaCertNumber      String? // self-reported until verified
  easaApprovalNumber String?
  verification       OrgVerification    @default(UNVERIFIED)
  verifiedAt         DateTime?
  publicKey          String
  encPrivateKey      String? // AES-GCM envelope. Null for bring-your-own-key orgs
  keyVersion         Int                @default(1)
  active             Boolean            @default(true)
  plan               Plan               @default(PILOT)
  stripeCustomerId   String?            @unique
  stripeSubId        String?            @unique
  subStatus          String?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  apiKeys            ApiKey[]
  parts              Part[]             @relation("CurrentCustodian")
  events             PartEvent[]
  checks             CertificateCheck[]
  auditLogs          AuditLog[]
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  prefix         String // first characters, safe to display
  hash           String       @unique // SHA-256 of the full key
  createdAt      DateTime     @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@index([organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorUserId    String?
  action         String
  meta           String? // JSON
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model StripeEvent {
  id         String   @id // Stripe event id, used to ignore duplicate webhooks
  type       String
  receivedAt DateTime @default(now())
}

model Part {
  id           String       @id @default(cuid())
  partNumber   String
  serialNumber String
  description  String?
  scrapped     Boolean      @default(false)
  currentOrgId String?
  currentOrg   Organization? @relation("CurrentCustodian", fields: [currentOrgId], references: [id])
  events       PartEvent[]
  createdAt    DateTime     @default(now())

  @@unique([partNumber, serialNumber])
  @@index([currentOrgId])
}

model PartEvent {
  id              String       @id @default(cuid())
  partId          String
  part            Part         @relation(fields: [partId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  seq             Int
  actorUserId     String? // the signed-in person who performed the action
  eventType       String // CREATED | INSPECTED | REPAIRED | OVERHAULED | INSTALLED | REMOVED | SCRAPPED | SOLD | TRANSFERRED
  timestamp       DateTime
  prevEventHash   String?
  eventHash       String
  signature       String // Base64 Ed25519
  data            String // exact JSON text that was hashed (never re-serialized)
  certificateHash String? // SHA-256 of attached PDF
  createdAt       DateTime     @default(now())

  @@unique([partId, seq])
  @@index([partId, timestamp])
  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, createdAt])
}

model CertificateCheck {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  fileName       String
  actorUserId    String?
  sha256         String
  extracted      String // JSON
  redFlags       String // JSON array
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

model SafetyFlag {
  id               String   @id @default(cuid())
  partNumber       String
  partNumberNorm   String
  source           String // "AD" or "SDR"
  referenceId      String
  description      String
  serialRangeStart String?
  serialRangeEnd   String?
  issuedDate       DateTime
  url              String?
  createdAt        DateTime @default(now())

  @@unique([source, referenceId, partNumberNorm])
  @@index([partNumberNorm])
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String
  role      String?
  volume    String? // certificates per month, self-reported
  message   String?
  source    String? // e.g. "pilot", "pro", "enterprise"
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model RepairStation {
  id             String   @id @default(cuid())
  certNumber     String   @unique // e.g. "RS1R..."
  name           String
  location       String?
  status         String   @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  airworthiness  Boolean  @default(true)
  createdAt      DateTime @default(now())
}